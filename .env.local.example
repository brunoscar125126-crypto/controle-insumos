# Postgres (Railway) — pega em Railway → seu projeto → Postgres → "Connect"
DATABASE_URL=postgresql://user:password@host.railway.app:5432/railway

# Auth.js — gere com `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=

# OAuth Client do Google Cloud Console (Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google em dev, e
# https://SEU_DOMINIO/api/auth/callback/google em produção)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare R2 (S3-compatible) — dashboard R2 → Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=establishment-assets
# "Public Development URL" do bucket (ou domínio customizado), sem "/" no final
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
