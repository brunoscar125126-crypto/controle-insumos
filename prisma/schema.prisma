generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================================
// Modelos do Auth.js (NextAuth) — formato exigido pelo @auth/prisma-adapter.
// Sessão usa estratégia JWT (ver auth.ts), então a tabela Session não é
// escrita em toda request — só User/Account são realmente usadas no login
// com Google. Mantidas por completude/compatibilidade com o adapter.
// ================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  // Hash bcrypt — só existe pra quem definiu login por e-mail/senha (ver
  // Credentials provider em auth.ts). Login via Google nunca preenche isso.
  password      String?

  accounts        Account[]
  sessions        Session[]
  estabelecimento Estabelecimento?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ================================================================
// Modelos de domínio — mesmas tabelas/colunas de quando o projeto rodava
// em cima do Supabase, só trocando RLS por checagem de estabelecimento_id
// nas Server Actions (ver lib/auth/estabelecimento.ts).
// ================================================================

model Estabelecimento {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  nome            String
  // Foto guardada direto no Postgres (bytea) — já chega redimensionada e
  // comprimida do browser (lib/image/resizeImage.ts), então o volume é
  // pequeno. Servida via app/api/estabelecimentos/[id]/logo/route.ts.
  logo            Bytes?
  logoContentType String?  @map("logo_content_type")
  corPrimaria     String?  @map("cor_primaria")
  corSecundaria   String?  @map("cor_secundaria")
  createdAt       DateTime @default(now()) @map("created_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categorias    Categoria[]
  insumos       Insumo[]
  listasCompras ListaCompras[]

  @@map("estabelecimentos")
}

model Categoria {
  id                String   @id @default(uuid())
  estabelecimentoId String   @map("estabelecimento_id")
  nome              String
  createdAt         DateTime @default(now()) @map("created_at")

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  insumos         Insumo[]

  @@unique([estabelecimentoId, nome])
  @@map("categorias")
}

model Insumo {
  id                String   @id @default(uuid())
  estabelecimentoId String   @map("estabelecimento_id")
  categoriaId       String   @map("categoria_id")
  nome              String
  quantidade        Decimal  @default(0) @db.Decimal(12, 3)
  unidade           String
  // Posição manual na lista (drag-and-drop) — menor primeiro. Novos
  // insumos entram no fim (maior ordem já usada + 1).
  ordem             Int      @default(0)
  // Idem Estabelecimento.logo — bytea direto no Postgres, servido via
  // app/api/insumos/[id]/foto/route.ts.
  foto              Bytes?
  fotoContentType   String?  @map("foto_content_type")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  estabelecimento    Estabelecimento    @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  categoria          Categoria          @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  listaComprasItens  ListaComprasItem[]

  @@index([estabelecimentoId])
  @@index([categoriaId])
  @@map("insumos")
}

// ================================================================
// Listas de compras — um "snapshot" de itens + quantidade a comprar,
// com nome e data escolhidos pelo usuário. Referencia o Insumo ao vivo
// (não guarda nome/unidade duplicados); se o insumo for excluído, o
// item correspondente na lista some junto (cascade), a lista em si fica.
// ================================================================

model ListaCompras {
  id                 String   @id @default(uuid())
  estabelecimentoId  String   @map("estabelecimento_id")
  nome               String
  data               DateTime @db.Date
  createdAt          DateTime @default(now()) @map("created_at")

  estabelecimento Estabelecimento    @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  itens           ListaComprasItem[]

  @@index([estabelecimentoId])
  @@map("listas_compras")
}

model ListaComprasItem {
  id             String  @id @default(uuid())
  listaComprasId String  @map("lista_compras_id")
  insumoId       String  @map("insumo_id")
  quantidade     Decimal @db.Decimal(12, 3)

  listaCompras ListaCompras @relation(fields: [listaComprasId], references: [id], onDelete: Cascade)
  insumo       Insumo       @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  @@unique([listaComprasId, insumoId])
  @@index([listaComprasId])
  @@map("lista_compras_itens")
}
